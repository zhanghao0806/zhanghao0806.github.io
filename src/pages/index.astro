---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatAlbum from '../components/CatAlbum.astro';
import { formatDate, sortPostsByDateDesc } from '../lib/writing.js';

const postModules = import.meta.glob('../content/blog/*.md', { eager: true });
const posts = sortPostsByDateDesc(Object.values(postModules));
const latestPosts = posts.slice(0, 5);
const featuredSlugs = ['llm01'];
const pinnedPosts = featuredSlugs
  .map((slug) => posts.find((post) => post.frontmatter.slug === slug))
  .filter(Boolean);
const featuredPosts = [
  ...pinnedPosts,
  ...posts
    .filter((post) => !featuredSlugs.includes(post.frontmatter.slug))
    .slice(0, Math.max(0, 3 - pinnedPosts.length)),
];
const featuredProjects = [
  {
    title: '个人主页与写作系统',
    summary: '基于 Astro 搭建的个人主页，支持文章分类、完整目录浏览、图片资源管理和 GitHub Pages 自动部署。',
    tags: ['Astro', 'GitHub Pages', 'Markdown'],
    links: [
      { label: 'GitHub', href: 'https://github.com/zhanghao0806/zhanghao0806.github.io' },
      { label: '线上页面', href: 'https://zhanghao0806.github.io/' },
    ],
  },

  {
    title: '计算系统跨层优化实验',
    summary: '通过两个简单实验复现两个问题：为什么 CPU 线程数越多，但是程序不一定越快？相同的多线程下，不同的内存布局，会如何影响多线程性能？',
    tags: ['性能分析', '缓存行'],
    links: [
      { label: 'GitHub', href: 'https://github.com/zhanghao0806/cpu_counter_experiment' },
      { label: '文章', href: 'https://zhanghao0806.github.io/blog/2026-10-20/' },
    ],
  },
];
---

<BaseLayout title="张浩 | 个人主页">
  <section class="home-profile" aria-labelledby="profile-name" lang="en">
    <div class="profile-portrait">
      <img src="/avatar.jpg" alt="Hao Zhang's cat avatar" width="940" height="939" decoding="async" />
      <p>A cat person, of course.</p>
    </div>
    <div class="profile-copy">
      <p class="profile-kicker">Master's student · Zhejiang University</p>
      <h1 id="profile-name">Hao Zhang <span lang="zh-CN">张浩</span></h1>
      <p class="profile-intro">
        I'm a master's student at the School of Software Technology, Zhejiang University.
        My current research focuses on AI Agents for Quantum Circuit Generation.
        Outside of my studies, I love cats.
      </p>
      <div class="profile-education">
        <h3>Education</h3>
        <ul>
          <li>
            <span class="profile-years">2026 — Present</span>
            <span><strong>Zhejiang University</strong><span class="profile-degree">Master's studies</span></span>
          </li>
          <li>
            <span class="profile-years">2021 — 2025</span>
            <span><strong>Nanjing University of Science and Technology</strong><span class="profile-degree">Undergraduate studies</span></span>
          </li>
        </ul>
      </div>
      <a class="profile-email" href="mailto:zhanghao4536@zju.edu.cn">
        <span>Email</span> zhanghao4536@zju.edu.cn <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>文章</h2>
      <a href="/blog/">查看全部 →</a>
    </div>
    <div class="card-grid">
      {
        featuredPosts.map((post) => (
          <article class="card">
            <p class="eyebrow">{formatDate(post.frontmatter.date)}</p>
            <h3><a href={`/blog/${post.frontmatter.slug}/`}>{post.frontmatter.title}</a></h3>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>项目</h2>
      <a href="/projects/">查看全部 →</a>
    </div>
    <div class="card-grid">
      {
        featuredProjects.map((project) => (
          <article class="card">
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <div class="tag-row">
              {project.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <div class="card-footer">
              {project.links.map((link) => <a href={link.href}>{link.label} →</a>)}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>最新文章</h2>
      <a href="/blog/">进入文章目录 →</a>
    </div>
    <ul class="writing-list">
      {
        latestPosts.map((post) => (
          <li class="writing-row">
            <time datetime={formatDate(post.frontmatter.date)}>{formatDate(post.frontmatter.date)}</time>
            <div>
              <h3><a href={`/blog/${post.frontmatter.slug}/`}>{post.frontmatter.title}</a></h3>
            </div>
            <span class="writing-arrow">›</span>
          </li>
        ))
      }
    </ul>
  </section>
  <CatAlbum />
</BaseLayout>

<style>
  .home-profile {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    align-items: start;
    gap: clamp(32px, 5vw, 64px);
    padding: 42px;
    margin-bottom: 32px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }

  .profile-portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 12px;
  }

  .profile-portrait p {
    margin: 14px 0 0;
    color: var(--muted);
    text-align: center;
    font-size: 13px;
  }

  .profile-kicker {
    margin: 0 0 12px;
    color: var(--accent);
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  #profile-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 18px;
    font-family: Georgia, "Songti SC", serif;
    font-size: clamp(36px, 4vw, 48px);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  #profile-name span {
    color: var(--muted);
    font-size: 0.55em;
    letter-spacing: 0.04em;
  }

  .profile-intro {
    margin: 22px 0 24px;
    color: #475569;
    font-size: 16px;
    line-height: 1.85;
  }

  .profile-education {
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .profile-education h3 {
    margin: 0 0 14px;
    font-size: 14px;
    font-weight: 650;
  }

  .profile-education ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }

  .profile-education li {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    gap: 16px;
  }

  .profile-education strong {
    font-weight: 550;
  }

  .profile-years,
  .profile-degree {
    color: var(--muted);
  }

  .profile-degree {
    display: block;
    font-size: 13px;
  }

  .profile-email {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin-top: 24px;
    font-size: 14px;
    overflow-wrap: anywhere;
  }

  .profile-email > span:first-child {
    font-weight: 650;
  }

  .profile-email:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .profile-email:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 5px;
  }

  @media (max-width: 850px) {
    .home-profile {
      grid-template-columns: 170px minmax(0, 1fr);
      gap: 28px;
      padding: 28px;
    }

    .profile-education li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  @media (max-width: 600px) {
    .home-profile {
      grid-template-columns: minmax(0, 1fr);
      padding: 24px;
    }

    .profile-portrait {
      width: 160px;
    }
  }

</style>
