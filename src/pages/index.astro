---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, sortPostsByDateDesc } from '../lib/writing.js';

const postModules = import.meta.glob('../content/blog/*.md', { eager: true });
const posts = sortPostsByDateDesc(Object.values(postModules));
const latestPosts = posts.slice(0, 5);
const featuredSlugs = ['llm01'];
const pinnedPosts = featuredSlugs
  .map((slug) => posts.find((post) => post.frontmatter.slug === slug))
  .filter(Boolean);
const featuredPosts = [
  ...pinnedPosts,
  ...posts
    .filter((post) => !featuredSlugs.includes(post.frontmatter.slug))
    .slice(0, Math.max(0, 3 - pinnedPosts.length)),
];
const featuredProjects = [
  {
    title: '个人主页与写作系统',
    summary: '基于 Astro 搭建的个人主页，支持文章分类、完整目录浏览、图片资源管理和 GitHub Pages 自动部署。',
    tags: ['Astro', 'GitHub Pages', 'Markdown'],
    links: [
      { label: 'GitHub', href: 'https://github.com/zhanghao0806/zhanghao0806.github.io' },
      { label: '线上页面', href: 'https://zhanghao0806.github.io/' },
    ],
  },
];
const heroImage = '/images/home/hero-zh-coder.jpg';
---

<BaseLayout title="张浩 | 个人主页">
  <section class="hero-panel">
    <div class="hero-copy">
      <h1>Pain is just pain</h1>
      <p class="hero-quote">“在坚冰还盖着北海的时候，我看到了怒放的梅花”</p>
      <div class="hero-actions">
        <a class="button primary" href="/blog/">阅读文章</a>
        <a class="button secondary" href="/projects/">查看项目</a>
      </div>
    </div>
    {
      heroImage ? (
        <img class="hero-image" src={heroImage} alt="" loading="lazy" decoding="async" />
      ) : (
        <div class="hero-visual" aria-hidden="true"></div>
      )
    }
  </section>

  <section class="section">
    <div class="section-header">
      <h2>文章</h2>
      <a href="/blog/">查看全部 →</a>
    </div>
    <div class="card-grid">
      {
        featuredPosts.map((post) => (
          <article class="card">
            <p class="eyebrow">{formatDate(post.frontmatter.date)}</p>
            <h3><a href={`/blog/${post.frontmatter.slug}/`}>{post.frontmatter.title}</a></h3>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>项目</h2>
      <a href="/projects/">查看全部 →</a>
    </div>
    <div class="card-grid">
      {
        featuredProjects.map((project) => (
          <article class="card">
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <div class="tag-row">
              {project.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <div class="card-footer">
              {project.links.map((link) => <a href={link.href}>{link.label} →</a>)}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>最新文章</h2>
      <a href="/blog/">进入文章目录 →</a>
    </div>
    <ul class="writing-list">
      {
        latestPosts.map((post) => (
          <li class="writing-row">
            <time datetime={formatDate(post.frontmatter.date)}>{formatDate(post.frontmatter.date)}</time>
            <div>
              <h3><a href={`/blog/${post.frontmatter.slug}/`}>{post.frontmatter.title}</a></h3>
            </div>
            <span class="writing-arrow">›</span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    justify-content: center;
    min-width: 0;
    padding: 12px 0;
  }

  .hero-copy h1 {
    font-size: clamp(36px, 4.5vw, 56px);
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .hero-quote {
    margin-top: 22px;
    max-width: 28em;
    color: var(--muted);
    font-family: "Songti SC", "STSong", "Noto Serif CJK SC", serif;
    font-size: clamp(19px, 1.8vw, 22px);
    font-style: italic;
    line-height: 1.9;
    text-wrap: balance;
  }

  .hero-copy .hero-actions {
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 40px;
  }

  .hero-copy .button {
    min-height: 46px;
    padding: 10px 20px;
    font-size: 16px;
  }

  @media (max-width: 700px) {
    .hero-copy {
      padding: 4px 0;
    }

    .hero-quote {
      margin-top: 18px;
    }

    .hero-copy .hero-actions {
      margin-top: 30px;
    }
  }
</style>
