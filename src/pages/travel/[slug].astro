---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleFontHead from '../../components/ArticleFontHead.astro';
import TravelDirectory from '../../components/TravelDirectory.astro';
import { getTravelPosts } from '../../lib/travel.js';
import { formatDate } from '../../lib/writing.js';

export function getStaticPaths() {
  const posts = getTravelPosts();
  const entries = posts.map(({ slug, frontmatter }) => ({ slug, title: frontmatter.title }));
  return posts.map(({ slug, frontmatter, Content }) => ({
    params: { slug },
    props: { frontmatter, Content, entries },
  }));
}

const { frontmatter, Content, entries } = Astro.props;
const { title, date, location, summary } = frontmatter;
---

<BaseLayout title={`${title} | 旅图`} description={summary} back={{ href: '/travel/', label: '返回旅图' }}>
  <ArticleFontHead slot="head" article={`travel/${Astro.params.slug}.md`} />
  <div class="travel-layout">
    <aside class="directory-panel">
      <h2>旅图</h2>
      <TravelDirectory entries={entries} currentSlug={Astro.params.slug} />
    </aside>
    <details class="directory-mobile">
      <summary>旅图</summary>
      <TravelDirectory entries={entries} currentSlug={Astro.params.slug} />
    </details>
    <article class="travel-entry">
      <header class="entry-header">
        <h1>{title}</h1>
        <p class="entry-meta">
          <time datetime={formatDate(date)}>{formatDate(date)}</time>
          {location && <span>{location}</span>}
        </p>
      </header>
      <div class="travel-prose">
        <Content />
      </div>
      <dialog class="photo-preview" aria-label="旅图照片预览">
        <form method="dialog">
          <button type="submit" autofocus>关闭 ×</button>
        </form>
        <img alt="" />
        <p class="photo-preview-caption" hidden></p>
      </dialog>
    </article>
  </div>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.photo-preview');
  const preview = dialog?.querySelector('img');
  const caption = dialog?.querySelector<HTMLParagraphElement>('.photo-preview-caption');
  let previewRequest = 0;

  for (const trigger of document.querySelectorAll<HTMLButtonElement>('.travel-photo-trigger')) {
    const image = trigger.querySelector('img');
    if (!image) continue;

    const figure = trigger.closest('figure');
    const alignPhoto = () => figure?.classList.toggle('portrait', image.naturalHeight > image.naturalWidth);
    image.addEventListener('load', alignPhoto);
    if (image.complete) alignPhoto();

    if (!dialog || !preview || !caption) continue;
    trigger.addEventListener('click', () => {
      const description = figure?.querySelector('figcaption')?.textContent ?? '';
      const fullSizeUrl = image.src;
      const request = ++previewRequest;
      preview.alt = image.alt || description;
      preview.src = image.currentSrc || fullSizeUrl;
      caption.textContent = description;
      caption.hidden = !description;
      trigger.focus({ preventScroll: true });
      dialog.showModal();

      if (preview.src !== fullSizeUrl) {
        const fullSize = new Image();
        fullSize.src = fullSizeUrl;
        void fullSize.decode().then(() => {
          if (dialog.open && request === previewRequest) preview.src = fullSizeUrl;
        }).catch(() => {
          // The image already displayed in the article remains available.
        });
      }
    });
  }

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => {
    if (!dialog.open) preview?.removeAttribute('src');
  });
</script>

<style>
  .travel-layout {
    display: grid;
    grid-template-columns: minmax(180px, 25%) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 60px);
    align-items: start;
  }

  .directory-panel {
    position: sticky;
    top: 96px;
    max-height: calc(100svh - 112px);
    overflow-y: auto;
    padding-inline-end: 20px;
    border-inline-end: 1px solid var(--line);
  }

  .directory-panel h2,
  .directory-mobile summary {
    margin: 0;
    padding: 8px 12px;
    font-size: 1rem;
    font-weight: 650;
  }

  .directory-mobile {
    display: none;
  }

  .travel-entry {
    min-width: 0;
    font-family: "Article Songti", "Songti SC", "STSong", "SimSun", "宋体",
      "Noto Serif CJK SC", "Noto Serif SC", "Source Han Serif SC", serif;
  }

  .entry-header {
    margin-bottom: 32px;
  }

  .entry-header h1 {
    margin: 0 0 10px;
    font-size: clamp(1.625rem, 2.5vw, 2rem);
    font-weight: 700;
    text-align: left;
  }

  .travel-prose :global(h1) {
    margin-block: 1em 0.4em;
    font-size: clamp(1.375rem, 2vw, 1.625rem);
    text-align: center;
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
  }

  .travel-prose {
    color: var(--text);
    font-size: clamp(1rem, 1.8vw, 1.125rem);
    line-height: 1.85;
    overflow-wrap: anywhere;
  }

  .travel-prose :global([data-source-whitespace="true"]) {
    white-space: break-spaces;
    tab-size: 1em;
  }

  .travel-prose :global(p + p) {
    margin-block-start: 0.65em;
  }

  .travel-prose :global(.travel-photo) {
    width: fit-content;
    max-width: 100%;
    margin: clamp(22px, 4vw, 38px) 0 clamp(22px, 4vw, 38px) auto;
  }

  .travel-prose :global(.travel-photo-trigger) {
    display: block;
    max-width: 100%;
    padding: 0;
    border: 0;
    border-radius: 10px;
    background: transparent;
    cursor: zoom-in;
  }

  .travel-prose :global(.travel-photo-trigger:focus-visible),
  .photo-preview button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .travel-prose :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 78svh;
    margin-inline-start: auto;
    border-radius: 10px;
  }

  .travel-prose :global(figcaption) {
    /* Let the photograph set the figure width, including for long captions. */
    inline-size: 0;
    min-inline-size: 100%;
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.55;
    text-align: center;
  }

  .travel-prose :global(.travel-photo.portrait),
  .travel-prose :global(.travel-photo.portrait img) {
    margin-inline: auto;
  }

  :global(html):has(.photo-preview[open]) {
    overflow: hidden;
  }

  .photo-preview {
    max-width: calc(100vw - 16px);
    max-height: calc(100dvh - 24px);
    padding: 0 0 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    color: var(--text);
    overscroll-behavior: contain;
  }

  .photo-preview::backdrop {
    background: rgba(15, 23, 42, 0.82);
  }

  .photo-preview form {
    display: flex;
    justify-content: flex-end;
    padding-inline: 8px;
  }

  .photo-preview button {
    min-height: 44px;
    padding: 0 8px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--accent-strong);
    cursor: pointer;
    font: inherit;
  }

  .photo-preview button:hover {
    background: var(--accent-soft);
  }

  .photo-preview img {
    display: block;
    max-width: calc(100vw - 18px);
    max-height: calc(100dvh - 116px);
    margin-inline: auto;
    object-fit: contain;
  }

  .photo-preview-caption {
    max-width: 65ch;
    margin: 8px auto 0;
    padding-inline: 12px;
    font-size: 0.9rem;
    text-align: center;
    overflow-wrap: anywhere;
  }

  @media (max-width: 760px) {
    .travel-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .directory-panel {
      display: none;
    }

    .directory-mobile {
      display: block;
      max-height: 45svh;
      overflow-y: auto;
      border-block: 1px solid var(--line);
    }

    .directory-mobile summary {
      cursor: pointer;
    }
  }
</style>
