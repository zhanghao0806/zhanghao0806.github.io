---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleFontHead from '../../components/ArticleFontHead.astro';
import { getTravelPosts } from '../../lib/travel.js';
import { formatDate } from '../../lib/writing.js';

export function getStaticPaths() {
  return getTravelPosts().map(({ slug, frontmatter, Content }) => ({
    params: { slug },
    props: { frontmatter, Content },
  }));
}

const { frontmatter, Content } = Astro.props;
const { title, date, location, summary } = frontmatter;
---

<BaseLayout title={`${title} | 旅图`} description={summary}>
  <ArticleFontHead slot="head" article={`travel/${Astro.params.slug}.md`} />
  <article class="travel-entry">
    <header class="entry-header">
      <a class="travel-back" href="/travel/">← 旅图</a>
      <h1>{title}</h1>
      <p class="entry-meta">
        <time datetime={formatDate(date)}>{formatDate(date)}</time>
        {location && <span>{location}</span>}
      </p>
    </header>
    <div class="travel-prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .travel-entry {
    width: min(100%, 680px);
    margin-inline: auto;
    font-family: "Article Songti", "Songti SC", "STSong", "SimSun", "宋体",
      "Noto Serif CJK SC", "Noto Serif SC", "Source Han Serif SC", serif;
  }

  .entry-header {
    margin-bottom: 32px;
  }

  .travel-back {
    display: inline-block;
    margin-bottom: 14px;
    font-size: 0.88rem;
  }

  .entry-header h1 {
    margin: 0 0 10px;
    font-size: clamp(2rem, 5vw, 3.45rem);
    font-weight: 700;
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
  }

  .travel-prose {
    color: var(--text);
    font-size: clamp(1rem, 1.8vw, 1.125rem);
    line-height: 1.85;
    overflow-wrap: anywhere;
  }

  .travel-prose :global(.travel-photo) {
    margin: clamp(22px, 4vw, 38px) 0;
    text-align: center;
  }

  .travel-prose :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 78svh;
    margin-inline: auto;
    border-radius: 10px;
  }

  .travel-prose :global(figcaption) {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.55;
  }
</style>
