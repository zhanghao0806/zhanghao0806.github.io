---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/writing.js';

const notes = Object.values(import.meta.glob('../../content/blog/*.md', { eager: true })).filter(
  (post) => post.frontmatter.category === 'reflections',
);
const sortedNotes = notes.sort(
  (a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf(),
);

---

<BaseLayout title="杂思录 | 张浩">
  <section class="hero">
    <p class="eyebrow">Reflections</p>
    <h1>杂思录</h1>
    <p class="lead">记录学习回顾、生活随想、阅读、观察和想法片段。</p>
  </section>

  <section class="section">
    <ul class="list">
      {
        sortedNotes.map((note) => (
          <li class="item">
            <h3>
              <a href={`/blog/${note.frontmatter.slug}/`}>{note.frontmatter.title}</a>
            </h3>
            <p class="meta">{formatDate(note.frontmatter.date)}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
