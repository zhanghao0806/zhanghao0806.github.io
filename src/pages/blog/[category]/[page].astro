---
import { CATEGORIES } from '../../../lib/writing.js';

// Keep previously published pagination URLs working after switching to full lists.
export async function getStaticPaths() {
  const allPosts = Object.values(import.meta.glob('../../../content/blog/*.md', { eager: true }));
  const legacyPageSize = 5;

  return CATEGORIES.flatMap((category) => {
    const count = allPosts.filter((post) => post.frontmatter.category === category.key).length;
    const totalPages = Math.ceil(count / legacyPageSize);

    return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => ({
      params: { category: category.key, page: String(index + 2) },
    }));
  });
}

return Astro.redirect(`/blog/${Astro.params.category}/`);
---
