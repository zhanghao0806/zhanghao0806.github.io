---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import ArticleComments from '../../components/ArticleComments.astro';
import ArticleFontHead from '../../components/ArticleFontHead.astro';
import { categoryLabels, formatDate } from '../../lib/writing.js';
import '../../styles/article-sakura.css';
import { basename } from 'node:path';

export async function getStaticPaths() {
  const posts = Object.values(import.meta.glob('../../content/blog/*.md', { eager: true }));

  return posts.map((post) => ({
    params: { slug: post.frontmatter.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const backlink = new URL(`/blog/${encodeURIComponent(post.frontmatter.slug)}/`, Astro.site);
const Content = post.Content;
const headings = post.getHeadings();
const hasToc = headings.length > 0;
const headingStartDepth = hasToc
  ? Math.min(...headings.map(({ depth }) => depth))
  : undefined;

---

<BaseLayout title={`${post.frontmatter.title} | Blog`} back articleEffects>
  <Fragment slot="head">
    <meta name="giscus:backlink" content={backlink.href} />
    <ArticleFontHead article={`blog/${basename(post.file)}`} />
  </Fragment>
  <div
    class:list={['article-reading-layout', { 'has-toc': hasToc }]}
    data-heading-start-depth={headingStartDepth}
    data-archive-category={categoryLabels[post.frontmatter.category] ? post.frontmatter.category : undefined}
  >
    {hasToc && <ArticleToc headings={headings} />}

    <article class="article-page">
      <header class="article-header">
        <p class="category">{categoryLabels[post.frontmatter.category]}</p>
        <h1>{post.frontmatter.title}</h1>
        <p class="meta">{formatDate(post.frontmatter.date)}</p>
      </header>

      <div class="article-prose">
        <Content />
      </div>
      <ArticleComments slug={String(post.frontmatter.slug)} />
    </article>
  </div>
</BaseLayout>

<script>
  const article = document.querySelector<HTMLElement>('.article-reading-layout');
  const backLink = document.querySelector<HTMLAnchorElement>('.nav-back');
  const category = article?.dataset.archiveCategory;
  const source = new URLSearchParams(window.location.search).get('from');

  if (backLink && category && source === category) {
    backLink.href = `/blog/${encodeURIComponent(category)}/`;
  }
</script>
