---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import { categoryLabels, formatDate } from '../../lib/writing.js';
import '../../styles/article-sakura.css';
import { basename } from 'node:path';
import articleFonts from '../../generated/article-fonts.json';

export async function getStaticPaths() {
  const posts = Object.values(import.meta.glob('../../content/blog/*.md', { eager: true }));

  return posts.map((post) => ({
    params: { slug: post.frontmatter.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const font = articleFonts[basename(post.file)];
if (!font) throw new Error(`缺少文章字体：${post.file}，请运行 npm run font:subset。`);
const fontFaces = `
  @font-face { font-family: "Article Songti"; src: url("${font.regular}") format("woff2"); font-style: normal; font-weight: 400; font-display: swap; }
  @font-face { font-family: "Article Songti"; src: url("${font.bold}") format("woff2"); font-style: normal; font-weight: 700; font-display: swap; }
`;
const Content = post.Content;
const headings = post.getHeadings();
const hasToc = headings.length > 0;
const headingStartDepth = hasToc
  ? Math.min(...headings.map(({ depth }) => depth))
  : undefined;

---

<BaseLayout title={`${post.frontmatter.title} | Blog`} back articleEffects>
  <Fragment slot="head">
    <link rel="preload" href={font.regular} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={font.bold} as="font" type="font/woff2" crossorigin="anonymous" />
    <style is:inline set:html={fontFaces} />
  </Fragment>
  <div
    class:list={['article-reading-layout', { 'has-toc': hasToc }]}
    data-heading-start-depth={headingStartDepth}
  >
    {hasToc && <ArticleToc headings={headings} />}

    <article class="article-page">
      <header class="article-header">
        <p class="category">{categoryLabels[post.frontmatter.category]}</p>
        <h1>{post.frontmatter.title}</h1>
        <p class="meta">{formatDate(post.frontmatter.date)}</p>
      </header>

      <div class="article-prose">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>
