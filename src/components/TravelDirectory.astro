---
interface Props {
  entries: { slug: string; title: string }[];
  currentSlug: string;
}

const { entries, currentSlug } = Astro.props;
---

<nav aria-label="旅图">
  <ul>
    {entries.map(({ slug, title }) => (
      <li>
        <a href={`/travel/${encodeURIComponent(slug)}/`} aria-current={slug === currentSlug ? 'page' : undefined}>
          {title}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    padding: 8px 12px;
    border-inline-start: 2px solid transparent;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  a:hover,
  a:focus-visible,
  a[aria-current="page"] {
    color: var(--accent-strong);
    background: var(--accent-soft);
  }

  a[aria-current="page"] {
    border-color: var(--accent);
    font-weight: 650;
  }
</style>
