---
import '../styles/cat-companion.css';

const pagePath = Astro.url.pathname;

// A smooth displacement field for the cat's anatomical LEFT (viewer-right) eye.
// It remaps the assembled layers together, preserving their color and area ratios.
// Coordinates use the existing 384×576 artwork; outside the eye the field is neutral.
const eyeCenter = { x: 264.6, y: 106 };
const fieldRows = Array.from({ length: 56 }, (_, row) => {
  const y = 82 + row;
  const sourceY = eyeCenter.y + (y - eyeCenter.y - 4.8) / 1.13;
  const green = Math.max(0, Math.min(255, Math.round(128 + (sourceY - y) / 48 * 255)));
  const redAt = (x: number) => Math.round(128 + ((x - eyeCenter.x) / 1.08 - (x - eyeCenter.x)) / 32 * 255);
  return `<linearGradient id="row-${row}"><stop stop-color="rgb(${redAt(232)},${green},128)"/><stop offset="1" stop-color="rgb(${redAt(298)},${green},128)"/></linearGradient>
    <rect x="232" y="${y}" width="66" height="1" fill="url(#row-${row})"/>`;
}).join('');
const eyeField = `<svg xmlns="http://www.w3.org/2000/svg" width="384" height="576" viewBox="0 0 384 576">
  <defs><radialGradient id="falloff"><stop offset="0.6" stop-color="white"/><stop offset="1" stop-color="black"/></radialGradient>
  <mask id="region"><ellipse cx="264.6" cy="110.8" rx="31" ry="27" fill="url(#falloff)"/></mask></defs>
  <rect width="384" height="576" fill="rgb(128,128,128)"/>
  <g mask="url(#region)">${fieldRows}</g>
</svg>`;
const eyeFieldUrl = `data:image/svg+xml,${encodeURIComponent(eyeField)}`;
---

<svg width="0" height="0" aria-hidden="true" style="position:absolute;pointer-events:none">
  <defs>
    <filter id="cat-left-eye-shape" x="-0.05" y="-0.05" width="1.1" height="1.1"
      primitiveUnits="objectBoundingBox" color-interpolation-filters="sRGB">
      <feImage href={eyeFieldUrl} x="0" y="0" width="1" height="1" result="eye-field" />
      <feComponentTransfer in="eye-field" result="centered-field">
        <feFuncR type="linear" slope="1" intercept="-0.0019607843" />
        <feFuncG type="linear" slope="1" intercept="-0.0019607843" />
      </feComponentTransfer>
      <feDisplacementMap in="SourceGraphic" in2="centered-field" scale="0.0833333333"
        xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </defs>
</svg>

<aside
  class="cat-companion"
  data-cat-companion
  data-page-path={pagePath}
  data-visible="false"
  data-renderer="loading"
  data-state="idle"
  data-size-mode="normal"
  data-size-contract="172x258"
  aria-label="互动猫咪精灵"
>
  <div class="cat-companion__bubble" data-pet-bubble aria-hidden="true">
    <span data-pet-bubble-text></span>
  </div>
  <span
    class="cat-companion__live"
    data-pet-live
    aria-live="polite"
    aria-atomic="true"
  ></span>

  <div
    class="cat-companion__stage"
    data-pet-stage
    data-pet-drag-handle
    role="button"
    tabindex="0"
    aria-label="摸摸猫咪"
  >
    <div class="cat-companion__drift" data-pet-drift>
      <div class="cat-companion__reaction-shell" data-pet-reaction-shell>
        <div class="cat-companion__breathe" data-pet-breathe>
          <div class="cat-companion__character" data-pet-character aria-hidden="true">
            <div class="cat-companion__walk" data-pet-walk-root aria-hidden="true"></div>
            <div class="cat-companion__asset-root" data-pet-asset-root aria-hidden="true"></div>
            <span class="cat-companion__part cat-companion__tail" data-pet-part="tail"></span>
            <span class="cat-companion__part cat-companion__body" data-pet-part="body"></span>
            <span class="cat-companion__part cat-companion__paw" data-pet-part="paw"></span>
            <div class="cat-companion__head-group" data-pet-head-group>
              <div class="cat-companion__head-motion" data-pet-head-motion>
                <span class="cat-companion__part cat-companion__ear cat-companion__ear--left" data-pet-part="ear-left"></span>
                <span class="cat-companion__part cat-companion__ear cat-companion__ear--right" data-pet-part="ear-right"></span>
                <span class="cat-companion__part cat-companion__head" data-pet-part="head"></span>
                <span class="cat-companion__part cat-companion__eye cat-companion__eye--left" data-pet-part="eye-left"></span>
                <span class="cat-companion__part cat-companion__eye cat-companion__eye--right" data-pet-part="eye-right"></span>
                <span class="cat-companion__part cat-companion__pupil cat-companion__pupil--left" data-pet-part="pupil-left"></span>
                <span class="cat-companion__part cat-companion__pupil cat-companion__pupil--right" data-pet-part="pupil-right"></span>
                <span class="cat-companion__part cat-companion__eyelid cat-companion__eyelid--left" data-pet-part="eyelid-left"></span>
                <span class="cat-companion__part cat-companion__eyelid cat-companion__eyelid--right" data-pet-part="eyelid-right"></span>
                <span class="cat-companion__part cat-companion__nose" data-pet-part="nose"></span>
                <span class="cat-companion__part cat-companion__mouth" data-pet-part="mouth"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="cat-companion__toolbar" data-pet-toolbar role="group" aria-label="猫咪工具">
    <button
      class="cat-companion__tool"
      type="button"
      data-pet-action="toy"
      aria-label="开启逗猫棒模式"
      aria-pressed="false"
      title="逗猫棒"
    >
      <span class="cat-companion__tool-mark" aria-hidden="true">✦</span>
    </button>
    <button
      class="cat-companion__tool"
      type="button"
      data-pet-action="giant"
      aria-label="进入巨大模式"
      aria-pressed="false"
      title="巨大模式"
    >
      <span class="cat-companion__tool-mark cat-companion__tool-mark--giant" aria-hidden="true">⛶</span>
    </button>
    <button
      class="cat-companion__tool"
      type="button"
      data-pet-action="hide"
      aria-label="隐藏猫咪"
      title="隐藏猫咪"
    >
      <span class="cat-companion__tool-mark cat-companion__tool-mark--hide" aria-hidden="true">⌄</span>
    </button>
  </div>

  <div class="cat-companion__toy" data-pet-toy aria-hidden="true">
    <span class="cat-companion__toy-string"></span>
    <span class="cat-companion__toy-feather"></span>
  </div>

  <div class="cat-companion__particles" data-pet-particles aria-hidden="true"></div>

  <button class="cat-companion__recall" type="button" data-pet-recall aria-label="叫回猫咪" title="叫回猫咪">
    <span class="cat-companion__recall-mark" aria-hidden="true">🐾</span>
  </button>
</aside>

<script>
  import { mountCatCompanions } from '../scripts/cat-companion/controller';

  mountCatCompanions();
</script>
