---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, categoryLabels, formatDate, sortPostsByDateDesc } from '../lib/writing.js';

const { category, posts } = Astro.props;
const sourceQuery = category ? `?from=${encodeURIComponent(category.key)}` : '';
const allPosts = sortPostsByDateDesc(
  Object.values(import.meta.glob('../content/blog/*.md', { eager: true })),
);
const navigation = [
  { key: '', title: '全部文章' },
  ...CATEGORIES,
].map((item) => ({
  ...item,
  count: item.key ? allPosts.filter((post) => post.frontmatter.category === item.key).length : allPosts.length,
}));
---

<BaseLayout title={`${category?.title || '文章'} | 张浩`} writing>
  <div class="writing-archive">
    <div class="archive-layout">
      <nav class="archive-categories" aria-label="文章分类">
        {navigation.map((item) => (
          <a class="archive-category" data-category={item.key} data-title={item.title} href={item.key ? `/blog/${item.key}/` : '/blog/'} aria-current={(category?.key || '') === item.key ? 'page' : undefined}>
            <span>{item.title}</span><span class="archive-count">{item.count}</span>
          </a>
        ))}
      </nav>
      <section class="archive-content" aria-labelledby="archive-title">
        <h1 id="archive-title" class="archive-title">{category?.title || '全部文章'}</h1>
        <ul class="archive-list">
          {allPosts.map((post) => (
            <li class="archive-row" data-category={post.frontmatter.category} hidden={!!category && category.key !== post.frontmatter.category}>
              <div><h2><a href={`/blog/${post.frontmatter.slug}/${sourceQuery}`}>{post.frontmatter.title}</a></h2>
                <span class="archive-label" hidden={!!category}>{categoryLabels[post.frontmatter.category]}</span>
              </div>
              <time datetime={formatDate(post.frontmatter.date)}>{formatDate(post.frontmatter.date).replaceAll('-', '.')}</time>
            </li>
          ))}
        </ul>
        <p class="empty-state" hidden={posts.length > 0}>暂无文章。</p>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  const archive = document.querySelector<HTMLElement>('.writing-archive');
  if (archive) {
    const links = [...archive.querySelectorAll<HTMLAnchorElement>('.archive-category')];
    const rows = [...archive.querySelectorAll<HTMLElement>('.archive-row')];
    const heading = archive.querySelector<HTMLElement>('#archive-title')!;
    const emptyState = archive.querySelector<HTMLElement>('.empty-state')!;

    function showCategory(link: HTMLAnchorElement) {
      const category = link.dataset.category!;
      for (const item of links) {
        if (item === link) item.setAttribute('aria-current', 'page');
        else item.removeAttribute('aria-current');
      }

      let visibleCount = 0;
      for (const row of rows) {
        row.hidden = category !== '' && row.dataset.category !== category;
        if (!row.hidden) visibleCount += 1;
        row.querySelector<HTMLElement>('.archive-label')!.hidden = category !== '';
        const articleLink = row.querySelector<HTMLAnchorElement>('h2 a')!;
        const url = new URL(articleLink.href);
        if (category) url.searchParams.set('from', category);
        else url.searchParams.delete('from');
        articleLink.href = url.pathname + url.search;
      }

      heading.textContent = link.dataset.title!;
      document.title = `${category ? link.dataset.title : '文章'} | 张浩`;
      emptyState.hidden = visibleCount > 0;
    }

    for (const link of links) {
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        if (window.location.pathname !== link.pathname) {
          window.history.pushState(null, '', link.pathname);
        }
        showCategory(link);
      });
    }

    window.addEventListener('popstate', () => {
      const link = links.find((item) => item.pathname === window.location.pathname);
      if (link) showCategory(link);
    });
  }
</script>

<style>
  .writing-archive {
    width: 100%;
    padding: 24px 30px 30px;
    border: 1px solid rgba(226, 232, 240, 0.78);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 12px 36px rgba(15, 23, 42, 0.045);
  }

  .archive-layout {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .archive-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  .archive-category {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    padding: 8px 12px;
    border-radius: 8px;
    color: var(--text);
    font-size: 14px;
  }

  .archive-category:hover {
    background: var(--surface-soft);
  }

  .archive-category[aria-current="page"] {
    background: var(--accent-soft);
  }

  .archive-count {
    color: var(--muted);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .archive-content { min-width: 0; }

  .archive-title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .archive-label {
    color: var(--muted);
    font-size: 12px;
  }

  .archive-list { list-style: none; margin: 0; padding: 0; }

  .archive-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
  }

  .archive-row:last-child { border-bottom: 0; }

  .archive-row[hidden],
  .archive-label[hidden],
  .empty-state[hidden] { display: none; }

  .archive-row h2 {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .archive-row h2 a { color: var(--accent); }
  .archive-row h2 a:hover { color: var(--accent-strong); }
  .archive-label { display: block; margin-top: 4px; }

  .archive-row time {
    color: var(--muted);
    font-size: 12px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .archive-category:focus-visible,
  .archive-row a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 700px) {
    .writing-archive { padding: 16px 18px 20px; }
    .archive-categories { gap: 4px; }
    .archive-category { font-size: 13px; }
    .archive-row { gap: 12px; padding: 12px 0; }
  }

  @media (max-width: 400px) {
    .archive-row { grid-template-columns: 1fr; gap: 5px; }
  }
</style>
