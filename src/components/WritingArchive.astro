---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, categoryLabels, formatDate } from '../lib/writing.js';

const { category, posts } = Astro.props;
const allPosts = Object.values(import.meta.glob('../content/blog/*.md', { eager: true }));
const navigation = [
  { key: '', title: '全部文章' },
  ...CATEGORIES,
].map((item) => ({
  ...item,
  count: item.key ? allPosts.filter((post) => post.frontmatter.category === item.key).length : allPosts.length,
}));
const icons = {
  '': 'M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z',
  experiment: 'M9 3h6 M10 3v7L4 19q-1 2 2 2h12q3 0 2-2l-6-9V3 M8 15h8',
  paper: 'M6 3h9l4 4v14H6z M14 3v5h5 M9 12h7 M9 16h7',
  note: 'M5 3h14v18H5z M3 7h4 M3 12h4 M3 17h4 M10 8h5 M10 12h5',
  reflections: 'M4 4h16v12H10l-5 4v-4H4z M8 8h8 M8 12h5',
  life: 'M3 11l9-8 9 8 M5 10v11h14V10 M10 21v-7h4v7',
};
---

<BaseLayout title={`${category?.title || '文章'} | 张浩`} writing>
  <div class="writing-archive">
    <header class="archive-heading"><h1>文章</h1></header>
    <div class="archive-layout">
      <nav class="archive-sidebar" aria-label="文章分类">
        {navigation.map((item) => (
          <a class="archive-category" href={item.key ? `/blog/${item.key}/` : '/blog/'} aria-current={(category?.key || '') === item.key ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[item.key]} /></svg>
            <span>{item.title}</span><span class="archive-count">{item.count}</span>
          </a>
        ))}
      </nav>
      <section class="archive-content" aria-label={category?.title || '全部文章'}>
        <div class="archive-list-heading"><h2>{category?.title || '全部文章'}</h2><span>{posts.length} 篇</span></div>
        <ul class="archive-list">
          {posts.map((post) => (
            <li class="archive-row">
              <div><h3><a href={`/blog/${post.frontmatter.slug}/`}>{post.frontmatter.title}</a></h3>
                {!category && <span class="archive-label">{categoryLabels[post.frontmatter.category]}</span>}
              </div>
              <time datetime={formatDate(post.frontmatter.date)}>{formatDate(post.frontmatter.date).replaceAll('-', '.')}</time>
            </li>
          ))}
        </ul>
        {posts.length === 0 && <p class="empty-state">暂无文章。</p>}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .archive-heading { margin-bottom: 28px; }
  .archive-heading h1 { font-size: clamp(28px, 3vw, 38px); font-weight: 700; letter-spacing: -0.03em; }
  .archive-layout { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: 42px; align-items: start; }
  .archive-sidebar { position: sticky; top: 112px; display: grid; gap: 5px; padding: 10px; border: 1px solid rgba(226,232,240,.78); border-radius: 16px; background: rgba(241,245,249,.75); box-shadow: 0 8px 28px rgba(15,23,42,.035), inset 0 1px 0 rgba(255,255,255,.9); backdrop-filter: blur(18px) saturate(1.15); -webkit-backdrop-filter: blur(18px) saturate(1.15); }
  .archive-category { display: flex; align-items: center; gap: 11px; min-height: 44px; padding: 9px 12px; border-radius: 9px; color: var(--text); font-size: 14px; transition: background .15s, color .15s; }
  .archive-category svg { width: 17px; height: 17px; flex: none; color: var(--accent); }
  .archive-category:hover { background: rgba(255,255,255,.65); color: var(--text); }
  .archive-category[aria-current="page"] { background: var(--accent-soft); color: var(--text); font-weight: 600; box-shadow: inset 0 0 0 1px rgba(63,95,143,.09), 0 1px 3px rgba(15,23,42,.04); }
  .archive-count { margin-left: auto; font-size: 12px; font-weight: 400; font-variant-numeric: tabular-nums; color: var(--muted); }
  .archive-content { min-width: 0; }
  .archive-list-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 8px 0 18px; border-bottom: 1px solid var(--line); }
  .archive-list-heading h2 { margin: 0; font-size: 17px; font-weight: 600; }
  .archive-list-heading > span, .archive-label { color: var(--muted); font-size: 12px; }
  .archive-list { list-style: none; margin: 0; padding: 0; }
  .archive-row { display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 24px; padding: 13px 0; border-bottom: 1px solid var(--line); }
  .archive-row h3 { margin: 0; font-size: 14px; font-weight: 500; line-height: 1.6; overflow-wrap: anywhere; }
  .archive-row h3 a { color: var(--accent); }
  .archive-row h3 a:hover { color: var(--accent-strong); }
  .archive-label { display: block; margin-top: 4px; }
  .archive-row time { color: var(--muted); font-size: 12px; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .archive-category:focus-visible, .archive-row a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 700px) {
    .archive-layout { grid-template-columns: 1fr; gap: 24px; }
    .archive-sidebar { position: static; display: flex; flex-wrap: wrap; gap: 4px; padding: 7px; }
    .archive-category { gap: 7px; padding: 8px 10px; font-size: 13px; }
    .archive-count { margin-left: 2px; }
    .archive-row { gap: 12px; padding: 12px 0; }
    .archive-row h3 { font-size: 14px; }
  }
  @media (max-width: 400px) { .archive-row { grid-template-columns: 1fr; gap: 5px; } }
  @media (prefers-reduced-motion: reduce) { .archive-category { transition: none; } }
</style>
